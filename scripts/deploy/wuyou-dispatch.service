[Unit]
Description=无忧排班服务
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/wuyou-dispatch/current/app/server.py

[Service]
Type=simple
User=dispatch
Group=dispatch
WorkingDirectory=/opt/wuyou-dispatch/current
EnvironmentFile=/etc/wuyou-dispatch.env
Environment=DISPATCH_DATA_DIR=/var/lib/wuyou-dispatch
Environment=DISPATCH_BACKUP_DIR=/var/backups/wuyou-dispatch
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env DISPATCH_HOST=127.0.0.1 DISPATCH_PORT=8848 DISPATCH_TEST_MODE=0 /usr/bin/python3 /opt/wuyou-dispatch/current/app/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wuyou-dispatch /var/backups/wuyou-dispatch
MemoryMax=512M
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
