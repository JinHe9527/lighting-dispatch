.tab-scroll { margin-bottom: 20rpx; white-space: nowrap; }
.tab-button { display: inline-flex; align-items: center; min-height: 62rpx; margin: 0 10rpx 0 0; padding: 0 24rpx; border: 1rpx solid #d8d3c8; border-radius: 999rpx; background: #fffdfa; color: #77756e; font-size: 21rpx; line-height: 1; }
.tab-button.active { border-color: #252720; background: #252720; color: #fffdfa; font-weight: 700; }
.settings-list { display: flex; flex-direction: column; gap: 13rpx; }
.setting-row { display: flex; align-items: stretch; min-height: 108rpx; }
.setting-main { flex: 1; min-width: 0; margin: 0; padding: 19rpx 22rpx; border-radius: 0; background: transparent; color: #1f211f; text-align: left; line-height: 1.35; }
.setting-main strong,.setting-main text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.setting-main strong { font-size: 25rpx; }
.setting-main text { margin-top: 6rpx; color: #85837b; font-size: 19rpx; }
.remove-button { flex: none; width: 94rpx; margin: 0; border-left: 1rpx solid #ebe7de; border-radius: 0; background: transparent; color: #a63d31; font-size: 20rpx; line-height: 1; }
.create-button { margin-top: 8rpx; }
.rule-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 100rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #ebe7de; }
.rule-row:last-child { border-bottom: 0; }
.rule-row strong,.rule-row text { display: block; }
.rule-row strong { font-size: 23rpx; }
.rule-row text { margin-top: 6rpx; color: #8b8980; font-size: 18rpx; }
.rule-input { width: 140rpx; height: 66rpx; padding: 0 18rpx; border: 1rpx solid #d8d3c8; border-radius: 14rpx; background: #f8f6f1; font-family: Menlo, monospace; font-size: 23rpx; text-align: right; }
.modal-mask { position: fixed; z-index: 200; inset: 0; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(19, 21, 18, 0.46); }
.modal-card { width: 100%; max-height: 88vh; overflow-y: auto; padding: 30rpx; border-radius: 30rpx 30rpx 22rpx 22rpx; background: #fffdfa; }
.modal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.modal-title { margin-top: 8rpx; font-family: "Songti SC", serif; font-size: 40rpx; font-weight: 700; }
.modal-head button { width: auto; margin: 0; padding: 10rpx; background: transparent; color: #77756e; font-size: 20rpx; line-height: 1; }
.field-row { display: flex; gap: 14rpx; }
.grow { flex: 1; min-width: 0; }
.compact-textarea { min-height: 110rpx; }
.switch-field { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; padding: 20rpx; border-radius: 16rpx; background: #f4f1ea; font-size: 23rpx; font-weight: 600; }
.modal-submit { margin-top: 28rpx; }
