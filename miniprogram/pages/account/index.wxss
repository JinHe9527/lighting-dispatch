.profile-card { display: grid; grid-template-columns: 84rpx minmax(0, 1fr) auto; align-items: center; gap: 18rpx; padding: 24rpx; }
.profile-avatar { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 26rpx; background: #252720; color: #fffdfa; font-family: "Songti SC", serif; font-size: 35rpx; font-weight: 700; }
.profile-main { min-width: 0; }
.profile-name { font-size: 31rpx; font-weight: 700; }
.profile-meta { margin-top: 8rpx; color: #838179; font-size: 21rpx; }
.bound-pill { padding: 10rpx 16rpx; border-radius: 999rpx; background: #e4f2e7; color: #347249; font-size: 20rpx; font-weight: 700; }
.sync-map { margin-top: 22rpx; padding: 26rpx 22rpx; border-radius: 24rpx; background: #282b25; color: #fffdfa; }
.sync-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.sync-entry strong { font-family: "Songti SC", serif; font-size: 27rpx; }
.sync-entry text { color: #aeafa7; font-size: 20rpx; }
.sync-entry.website { margin-top: 2rpx; }
.sync-line { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12rpx; margin: 20rpx 0; }
.sync-line view { height: 1rpx; background: #50534a; }
.sync-line text { color: #d9aa5c; font-size: 18rpx; font-weight: 700; }
.info-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 86rpx; padding: 17rpx 22rpx; border-bottom: 1rpx solid #ebe7de; }
.info-row:last-child { border-bottom: 0; }
.info-row text { color: #7f7d75; font-size: 22rpx; }
.info-row strong { font-size: 23rpx; }
.account-actions { display: flex; flex-direction: column; gap: 13rpx; margin-top: 28rpx; }
.account-actions button { margin: 0; }
