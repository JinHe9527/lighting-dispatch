<view class="page-shell">
  <view class="page-head">
    <view>
      <view class="page-kicker">WORK ORDERS</view>
      <view class="page-title">工单队列</view>
      <view class="page-subtitle">网站与小程序操作实时写入同一份工单数据</view>
    </view>
  </view>

  <view class="filter-strip">
    <scroll-view scroll-x class="filter-scroll" show-scrollbar="false">
      <button
        wx:for="{{filters}}"
        wx:key="key"
        class="filter-button {{filter === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="selectFilter"
      >{{item.label}}</button>
    </scroll-view>
    <input class="search-control" placeholder="搜索团队、任务或负责人" value="{{search}}" bindinput="handleSearch" />
  </view>

  <view wx:if="{{loading}}" class="card loading-state"><view class="spinner"></view><view class="state-title">正在读取工单</view></view>
  <view wx:elif="{{errorMessage}}" class="card error-state"><view class="state-title">工单加载失败</view><view class="state-copy">{{errorMessage}}</view></view>

  <view wx:else class="order-list">
    <view wx:for="{{visibleOrders}}" wx:key="id" class="card order-card">
      <view class="order-card-top" data-id="{{item.id}}" bindtap="showDetail">
        <view class="order-clock">
          <text>{{item.timeText}}</text>
          <text>{{item.dateText}}</text>
        </view>
        <view class="order-summary">
          <view class="order-team">{{item.team}}</view>
          <view class="order-task">{{item.grp}} · {{item.task_type}} · {{item.minutes}}分钟</view>
        </view>
        <view class="status-pill {{item.status}}">{{item.statusText}}</view>
      </view>
      <view class="order-meta" data-id="{{item.id}}" bindtap="showDetail">
        <text>负责人：{{item.assignee_name || '待认领'}}</text>
        <text wx:if="{{item.room}}">{{item.room}}</text>
        <text>编号 #{{item.id}}</text>
      </view>
      <view wx:if="{{item.canAssign || item.canStart || item.canComplete || item.canCancel}}" class="order-actions">
        <button wx:if="{{item.canAssign}}" class="secondary-button small-button" data-id="{{item.id}}" bindtap="assignOrder">{{item.canManageAssign ? '指派负责人' : '接单'}}</button>
        <button wx:if="{{item.canStart}}" class="primary-button small-button" data-id="{{item.id}}" bindtap="startOrder">开始任务</button>
        <button wx:if="{{item.canComplete}}" class="primary-button small-button" data-id="{{item.id}}" bindtap="showComplete">完成任务</button>
        <button wx:if="{{item.canCancel}}" class="danger-button small-button" data-id="{{item.id}}" bindtap="showCancel">取消</button>
      </view>
    </view>
    <view wx:if="{{!visibleOrders.length}}" class="card empty-state">
      <view class="state-title">没有符合条件的工单</view>
      <view class="state-copy">切换筛选条件，或下拉页面刷新。</view>
    </view>
  </view>
</view>

<view wx:if="{{modal}}" class="modal-mask" bindtap="closeModal">
  <view class="modal-card" catchtap="stopPropagation">
    <view class="modal-head">
      <view>
        <view class="page-kicker">ORDER #{{modal.order.id}}</view>
        <view class="modal-title">{{modal.type === 'complete' ? '完成任务' : modal.type === 'cancel' ? '取消工单' : modal.order.team}}</view>
      </view>
      <button class="close-button" bindtap="closeModal">关闭</button>
    </view>
    <view class="modal-order-summary">
      <view class="modal-time">{{modal.order.timeText}}</view>
      <view>
        <view class="modal-task">{{modal.order.grp}} · {{modal.order.task_type}}</view>
        <view class="modal-copy">{{modal.order.date}} · {{modal.order.room || '未设置房间'}}</view>
      </view>
    </view>

    <block wx:if="{{modal.type === 'detail'}}">
      <view class="detail-grid">
        <view><text>状态</text><strong>{{modal.order.statusText}}</strong></view>
        <view><text>负责人</text><strong>{{modal.order.assignee_name || '待认领'}}</strong></view>
        <view><text>预计时长</text><strong>{{modal.order.minutes}} 分钟</strong></view>
        <view><text>创建人</text><strong>{{modal.order.creator_name || '—'}}</strong></view>
      </view>
      <view wx:if="{{modal.order.note}}" class="detail-note">{{modal.order.note}}</view>
    </block>

    <block wx:elif="{{modal.type === 'complete'}}">
      <view class="field">
        <text class="field-label">完成说明</text>
        <textarea class="field-textarea" placeholder="填写现场结果和已完成内容" value="{{modalNote}}" bindinput="handleModalNote"></textarea>
      </view>
      <view class="field">
        <text class="field-label">时间说明（提前结束时必填）</text>
        <textarea class="field-textarea compact-textarea" placeholder="例如：比赛提前结束" value="{{modalReason}}" bindinput="handleModalReason"></textarea>
      </view>
      <button class="primary-button modal-submit" loading="{{submitting}}" bindtap="submitModal">确认完成</button>
    </block>

    <block wx:else>
      <view class="field">
        <text class="field-label">取消原因</text>
        <textarea class="field-textarea" placeholder="说明为什么取消这张工单" value="{{modalReason}}" bindinput="handleModalReason"></textarea>
      </view>
      <button class="danger-button modal-submit" loading="{{submitting}}" bindtap="submitModal">确认取消</button>
    </block>
  </view>
</view>

<app-nav wx:if="{{me}}" active="orders" user="{{me}}"></app-nav>
