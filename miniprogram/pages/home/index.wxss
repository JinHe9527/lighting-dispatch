.home-head { align-items: center; }

.duty-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 54rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8d3c8;
  border-radius: 999rpx;
  background: #fffdfa;
  color: #5e6059;
  font-size: 21rpx;
  font-weight: 700;
}

.duty-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3b9857;
  box-shadow: 0 0 0 6rpx rgba(59, 152, 87, 0.12);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.metric-card {
  min-height: 154rpx;
  padding: 26rpx;
  border: 1rpx solid #ddd8cd;
  border-radius: 22rpx;
  background: #fffdfa;
}

.metric-card.running {
  border-color: #283028;
  background: #252822;
  color: #fffdf7;
}

.metric-value {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1;
}

.metric-label {
  margin-top: 14rpx;
  color: #7d7b73;
  font-size: 22rpx;
  font-weight: 600;
}

.metric-card.running .metric-label { color: #b9b9af; }

.plain-link {
  margin: 0;
  padding: 8rpx 0;
  background: transparent;
  color: #9a681b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.order-line {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 118rpx;
  margin: 0;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #ebe7de;
  border-radius: 0;
  background: transparent;
  color: #1f211f;
  text-align: left;
  line-height: 1.3;
}

.order-line:last-child { border-bottom: 0; }

.order-time text { display: block; }
.order-time text:first-child { font-family: Menlo, monospace; font-size: 28rpx; font-weight: 700; }
.order-time text:last-child { margin-top: 6rpx; color: #929087; font-size: 19rpx; }
.order-main { min-width: 0; }
.order-title { overflow: hidden; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.order-copy { overflow: hidden; margin-top: 7rpx; color: #7e7c74; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.compact-empty { padding: 50rpx 24rpx; }
.retry-button { margin-top: 26rpx; }

.management-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.management-card {
  position: relative;
  min-height: 190rpx;
  margin: 0;
  padding: 28rpx 24rpx;
  border: 1rpx solid #ddd8cd;
  border-radius: 22rpx;
  background: #fffdfa;
  color: #1f211f;
  text-align: left;
  line-height: 1.35;
}

.management-index {
  color: #d7d2c8;
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 700;
}

.management-title { margin-top: 18rpx; font-size: 27rpx; font-weight: 700; }
.management-note { margin-top: 8rpx; color: #85837b; font-size: 20rpx; line-height: 1.5; }
