.nav-wrap {
  position: fixed;
  z-index: 90;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 12rpx 20rpx calc(env(safe-area-inset-bottom) + 12rpx);
  pointer-events: none;
}

.nav-rail {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  min-height: 96rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  background: rgba(28, 30, 27, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(23, 24, 21, 0.26);
  pointer-events: auto;
}

.nav-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  min-width: 0;
  margin: 0;
  padding: 8rpx 4rpx;
  border-radius: 20rpx;
  background: transparent;
  color: #aaa99f;
  font-size: 20rpx;
  line-height: 1;
}

.nav-item.active {
  background: #35372f;
  color: #fffaf0;
}

.nav-mark {
  width: 22rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #6d6f66;
}

.nav-item.active .nav-mark {
  width: 34rpx;
  background: #e3a43d;
}
